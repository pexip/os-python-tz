+def _read_timezones_from_zone_tab() -> set[str]:
+    timezones = set()
+    zone_tab = pathlib.Path("/usr/share/zoneinfo/zone1970.tab")
+    for line in zone_tab.read_text(encoding="utf-8").splitlines():
